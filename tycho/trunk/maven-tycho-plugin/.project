<projectDescription>
  <name>maven-tycho-plugin</name>
  <comment>The maven-tycho-plugin provides tools for integrating Maven, Eclipse and OSGi.</comment>
  <projects>
    <project>maven-osgi-compiler-plugin</project>
    <project>tycho-compiler-jdt</project>
    <project>tycho-osgi-components</project>
  </projects>
  <buildSpec>
    <buildCommand>
      <name>org.eclipse.jdt.core.javabuilder</name>
    </buildCommand>
  </buildSpec>
  <natures>
    <nature>org.eclipse.jdt.core.javanature</nature>
  </natures>
</projectDescription>