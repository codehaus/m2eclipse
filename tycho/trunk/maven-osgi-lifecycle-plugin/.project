<projectDescription>
  <name>maven-osgi-lifecycle-plugin</name>
  <comment>Provides lifecycles for building OSGi bundles</comment>
  <projects/>
  <buildSpec>
    <buildCommand>
      <name>org.eclipse.jdt.core.javabuilder</name>
    </buildCommand>
  </buildSpec>
  <natures>
    <nature>org.eclipse.jdt.core.javanature</nature>
  </natures>
</projectDescription>